{
  "schemaVersion": 1,
  "protocolVersion": "1.0",
  "id": "cy.tool.test",
  "name": "CyToolTest",
  "displayName": "CyToolTest",
  "description": "Reference standalone CyTool without AI dependencies",
  "vendor": "Cyberalien",
  "author": "Cyberalien",
  "version": "0.1.0",
  "executable": "cytool-test",
  "categories": [
    "development",
    "test"
  ],
  "tags": [
    "reference"
  ],
  "capabilities": [
    "jobs",
    "multi-client",
    "cancellation",
    "progress"
  ],
  "operations": [
    {
      "id": "echo",
      "name": "echo",
      "description": "Return the supplied text.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 65536
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 65536
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "canRunAsync": true,
      "canCancel": true,
      "supportsProgress": false,
      "supportedBackends": [],
      "permissions": []
    },
    {
      "id": "sleep",
      "name": "sleep",
      "description": "Wait cooperatively; demonstrates cancellation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 60,
            "default": 0.1
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "sleptSeconds": {
            "type": "number"
          }
        },
        "required": [
          "sleptSeconds"
        ],
        "additionalProperties": false
      },
      "canRunAsync": true,
      "canCancel": true,
      "supportsProgress": false,
      "supportedBackends": [],
      "permissions": []
    },
    {
      "id": "generate_file",
      "name": "generate_file",
      "description": "Create a UTF-8 file inside the isolated job workspace.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,80}$",
            "default": "result.txt"
          },
          "text": {
            "type": "string",
            "maxLength": 65536
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "x-cy-kind": "File"
          },
          "mimeType": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "integer"
          }
        },
        "required": [
          "file",
          "mimeType",
          "sizeBytes"
        ],
        "additionalProperties": false
      },
      "canRunAsync": true,
      "canCancel": true,
      "supportsProgress": false,
      "supportedBackends": [],
      "permissions": []
    },
    {
      "id": "allocate_ram",
      "name": "allocate_ram",
      "description": "Allocate up to 64 MiB of real RAM temporarily.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 67108864,
            "default": 1048576
          },
          "seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 60,
            "default": 0.1
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "allocatedBytes": {
            "type": "integer"
          }
        },
        "required": [
          "allocatedBytes"
        ],
        "additionalProperties": false
      },
      "canRunAsync": true,
      "canCancel": true,
      "supportsProgress": false,
      "supportedBackends": [],
      "permissions": []
    },
    {
      "id": "simulate_vram",
      "name": "simulate_vram",
      "description": "Reserve simulated VRAM. Requires a simulation device in an injected resource budget; never allocates GPU memory.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "default": 10737418240
          },
          "seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 60,
            "default": 0.1
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "simulated": {
            "const": true
          },
          "reservedBytes": {
            "type": "integer"
          }
        },
        "required": [
          "simulated",
          "reservedBytes"
        ],
        "additionalProperties": false
      },
      "canRunAsync": true,
      "canCancel": true,
      "supportsProgress": false,
      "supportedBackends": [],
      "permissions": []
    },
    {
      "id": "fail",
      "name": "fail",
      "description": "Raise a structured test error.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "default": "Expected test failure"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "canRunAsync": true,
      "canCancel": true,
      "supportsProgress": false,
      "supportedBackends": [],
      "permissions": []
    },
    {
      "id": "progress_test",
      "name": "progress_test",
      "description": "Report step-by-step progress.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "steps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 5
          },
          "seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 60,
            "default": 0.1
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "steps": {
            "type": "integer"
          }
        },
        "required": [
          "steps"
        ],
        "additionalProperties": false
      },
      "canRunAsync": true,
      "canCancel": true,
      "supportsProgress": true,
      "supportedBackends": [],
      "permissions": []
    }
  ],
  "backends": [],
  "platforms": [
    {
      "os": "Windows",
      "architecture": "x64",
      "status": "Supported",
      "computeBackends": [
        "CPU"
      ]
    },
    {
      "os": "Linux",
      "architecture": "x64",
      "status": "Supported",
      "computeBackends": [
        "CPU"
      ]
    },
    {
      "os": "macOS",
      "architecture": "ARM64",
      "status": "Experimental",
      "computeBackends": [
        "CPU"
      ]
    }
  ],
  "runtimeRequirements": [
    {
      "id": "python",
      "version": ">=3.11",
      "required": false
    }
  ],
  "interfaces": [
    "Native",
    "CLI",
    "JSONL",
    "HTTP",
    "MCP"
  ],
  "concurrency": {
    "policy": "Concurrent",
    "maxWorkers": 4
  },
  "idleUnloadPolicy": "AfterJob",
  "documentation": "Docs/CreatingYourFirstCyTool.md"
}
