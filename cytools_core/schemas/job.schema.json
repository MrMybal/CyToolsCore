{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cytools:v1:job",
  "$ref": "#/$defs/job",
  "$defs": {
    "job": {
      "type": "object",
      "properties": {
        "jobId": {
          "type": "string"
        },
        "clientId": {
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        },
        "workspaceId": {
          "type": "string"
        },
        "workspace": {
          "type": "string"
        },
        "toolId": {
          "type": "string"
        },
        "operationId": {
          "type": "string"
        },
        "backendId": {
          "type": "string"
        },
        "modelId": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "startedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "finishedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "parameters": {
          "type": "object"
        },
        "priority": {
          "type": "string",
          "enum": [
            "Interactive",
            "Critical",
            "High",
            "Normal",
            "Background",
            "Low"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "Created",
            "Queued",
            "WaitingForResources",
            "Preparing",
            "LoadingModel",
            "Running",
            "Paused",
            "Cancelling",
            "Cancelled",
            "Completed",
            "Failed"
          ]
        },
        "progress": {
          "$ref": "#/$defs/progress"
        },
        "outputs": {},
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/error"
            },
            {
              "type": "null"
            }
          ]
        },
        "visibility": {
          "type": "string",
          "enum": [
            "Owner",
            "Shared",
            "Global"
          ]
        },
        "sharedWith": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resourceEstimate": {
          "$ref": "#/$defs/resources"
        },
        "artifactsDeleted": {
          "type": "boolean"
        },
        "artifactDependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "jobId",
        "clientId",
        "sessionId",
        "workspaceId",
        "toolId",
        "operationId",
        "parameters",
        "priority",
        "state",
        "createdAt",
        "progress",
        "outputs",
        "error"
      ]
    },
    "progress": {
      "type": "object",
      "properties": {
        "percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "currentStep": {
          "type": "string"
        },
        "currentStepIndex": {
          "type": "integer",
          "minimum": 0
        },
        "stepCount": {
          "type": "integer",
          "minimum": 0
        },
        "etaSeconds": {
          "type": "number",
          "minimum": 0
        },
        "currentFile": {
          "type": "string"
        },
        "previewAvailable": {
          "type": "boolean"
        },
        "statusMessage": {
          "type": "string"
        }
      },
      "required": []
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "technicalDetails": {},
        "recoverable": {
          "type": "boolean"
        },
        "suggestedAction": {
          "type": [
            "string",
            "null"
          ]
        },
        "underlyingError": {}
      },
      "required": [
        "code",
        "message",
        "recoverable"
      ]
    },
    "resources": {
      "type": "object",
      "properties": {
        "ramBytes": {
          "type": "number",
          "minimum": 0
        },
        "vramBytes": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "diskBytes": {
          "type": "number",
          "minimum": 0
        },
        "temporaryDiskBytes": {
          "type": "number",
          "minimum": 0
        },
        "cpuThreads": {
          "type": "integer",
          "minimum": 0
        },
        "networkRequired": {
          "type": "boolean"
        },
        "durationSeconds": {
          "type": "number",
          "minimum": 0
        },
        "preferredDevice": {
          "type": "string"
        },
        "fallbackOptions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string"
              },
              "parameters": {
                "type": "object"
              },
              "description": {
                "type": "string"
              }
            },
            "required": []
          }
        },
        "cpu": {
          "type": "object",
          "properties": {
            "supported": {
              "type": "boolean"
            },
            "minimumCores": {
              "type": "integer",
              "minimum": 0
            },
            "recommendedCores": {
              "type": "integer",
              "minimum": 0
            },
            "minimumThreads": {
              "type": "integer",
              "minimum": 0
            },
            "recommendedThreads": {
              "type": "integer",
              "minimum": 0
            },
            "instructions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": []
        },
        "gpu": {
          "type": "object",
          "properties": {
            "supported": {
              "type": "boolean"
            },
            "required": {
              "type": "boolean"
            },
            "vendors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "computeBackends": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": []
        },
        "ram": {
          "$ref": "#/$defs/memory"
        },
        "vram": {
          "$ref": "#/$defs/memory"
        }
      },
      "required": []
    },
    "memory": {
      "type": "object",
      "properties": {
        "minimum": {
          "type": "number",
          "minimum": 0
        },
        "recommended": {
          "type": "number",
          "minimum": 0
        },
        "estimatedLoaded": {
          "type": "number",
          "minimum": 0
        },
        "estimatedRuntime": {
          "type": "number",
          "minimum": 0
        },
        "estimatedPeak": {
          "type": "number",
          "minimum": 0
        },
        "observedPeak": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": []
    }
  }
}
